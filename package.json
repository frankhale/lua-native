{
  "name": "lua-native",
  "description": "A native Node.js module for embedding Lua in your apps",
  "author": "Frank Hale",
  "license": "MIT",
  "type": "module",
  "version": "1.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "keywords": [
    "lua",
    "scripting",
    "native",
    "embedding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankhale/lua-native.git"
  },
  "scripts": {
    "prebuildify": "prebuildify --napi --strip",
    "install": "node-gyp-build",
    "build-debug": "node-gyp rebuild --debug -- -Dskip_test=0",
    "build-release": "node-gyp rebuild --release -- -Dskip_test=1",
    "build-asan": "node-gyp rebuild --debug -- -Dskip_test=0 -Dsanitize=1",
    "test-cpp-asan": "npm run build-asan && node run-tests.js",
    "build-cpp-tsan": "node-gyp rebuild --debug -- -Dskip_test=0 -Dcpp_tsan=1",
    "test-cpp-tsan": "npm run build-cpp-tsan && node run-tests.js",
    "build-asan-addon": "node-gyp rebuild --debug -- -Dskip_test=1 -Daddon_asan=1",
    "test-ts-asan": "npm run build-asan-addon && node run-sanitized-ts.js asan",
    "test-harness-asan": "npm run build-asan-addon && node run-sanitized-ts.js asan tools/cross-context/run.mjs && node run-sanitized-ts.js asan tools/capability-matrix/run.mjs && node run-sanitized-ts.js asan tools/lifecycle-matrix/run.mjs && node run-sanitized-ts.js asan tools/exception-matrix/run.mjs",
    "build-tsan-addon": "node-gyp rebuild --debug -- -Dskip_test=1 -Daddon_tsan=1",
    "test-ts-tsan": "npm run build-tsan-addon && node run-sanitized-ts.js tsan",
    "build-cmake-debug": "node cmake-build.js debug",
    "build-cmake-release": "node cmake-build.js release",
    "clean": "node-gyp clean && node -e \"for (const d of ['prebuilds','cmake-build-debug','cmake-build-release','cmake-build-debug-visual-studio','cmake-build-release-visual-studio']) require('node:fs').rmSync(d, {recursive: true, force: true})\"",
    "start": "vitest",
    "test": "vitest",
    "test-cpp": "npm run build-debug && node run-tests.js",
    "check-invariants": "node tools/invariants/run.mjs",
    "oracle": "node tools/diff-oracle/run.mjs",
    "exception-matrix": "node tools/exception-matrix/run.mjs",
    "roundtrip-matrix": "node tools/roundtrip-matrix/run.mjs",
    "exec-parity": "node tools/exec-parity/run.mjs",
    "lifecycle-matrix": "node tools/lifecycle-matrix/run.mjs",
    "cross-context": "node tools/cross-context/run.mjs",
    "capability-matrix": "node tools/capability-matrix/run.mjs",
    "binding-balance": "node --expose-gc tools/binding-balance/run.mjs",
    "crossing-cost": "node tools/crossing-cost/run.mjs",
    "get-vcpkg-include": "node get_vcpkg_path.js include",
    "get-vcpkg-lib": "node get_vcpkg_path.js lib"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "types.d.ts",
    "prebuilds/**/*"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.1",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "@types/node": "*"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "prebuildify": "^6.0.1",
    "vitest": "^4.1.10"
  }
}